{
  "productName": "MiniVidCut",
  "version": "1.7.0",
  "identifier": "com.minividcut.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MiniVidCut",
        "decorations": false,
        "width": 1240,
        "height": 820,
        "minWidth": 820,
        "minHeight": 650,
        "backgroundColor": "#101010"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "resources": {
      "../LICENSE": "licenses/MiniVidCut-LICENSE.txt",
      "../docs/third-party-notices.txt": "licenses/third-party-notices.txt",
      "binaries/ffmpeg-COPYING.txt": "licenses/ffmpeg-COPYING.txt"
    },
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyMjVFN0FCQzQzNzc3MEEKUldRS2R6ZkVxK2NsUW1TaTNuOFBqU2srRDg3OC8yY01HY3VGZkI0SUxqU1dVOG9NU2VpeG9zWGIK",
      "endpoints": [
        "https://github.com/ritechoice23/minividcut/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
